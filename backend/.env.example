# Copy this file to .env and adjust values for your local setup.
DATABASE_URL=postgresql://localhost/thriver_db
ALLOWED_ORIGINS=*
APP_NAME=Thriver Backend
ENV=development
SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_SIGNUP_SECRET=thriver-admin

# Production (ENV=production) requires real values for the three below:
# ENV=production
# SECRET_KEY=<openssl rand -hex 32>
# ADMIN_SIGNUP_SECRET=<something private>
# ALLOWED_ORIGINS=https://your-web-app.example
